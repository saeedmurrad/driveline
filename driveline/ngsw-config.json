{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/*.css",
          "/*.js",
          "/site.webmanifest",
          "/favicon.ico",
          "/favicon.svg",
          "/favicon.png",
          "/apple-touch-icon.png",
          "/brand/*.svg",
          "/payment/**",
          "/partners/**"
        ]
      }
    },
    {
      "name": "artwork",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/brand/*.png", "/hero/*.webp", "/hero/*.jpeg"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "stock-photos",
      "urls": ["/stock/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "7d"
      }
    }
  ]
}
