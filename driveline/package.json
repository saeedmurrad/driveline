{
  "name": "driveline",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/platform-api-dev.mjs & ng serve",
    "start:api": "node scripts/platform-api-dev.mjs",
    "start:web": "ng serve",
    "build": "ng build && cp -r platform dist/driveline/platform",
    "build:gh-pages": "node scripts/generate-sitemap.mjs && ng build --configuration production,github-pages --base-href /",
    "build:gh-pages-github-io": "ng build --configuration production,github-pages --base-href /driveline/",
    "test:rules": "firebase emulators:exec --only auth,firestore --project driveline-car-sales \"node scripts/test-firestore-rules.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project driveline-car-sales",
    "sync:stock": "node scripts/fetch-fengate-stock.mjs && node scripts/stock-history.mjs && node scripts/verify-stock.mjs && node scripts/filter-stock-images.mjs && node scripts/tag-stock-photos.mjs && node scripts/optimize-stock-images.mjs && node scripts/generate-share-images.mjs && node scripts/generate-sitemap.mjs",
    "seed:platform": "node scripts/seed-platform.mjs",
    "export:platform-snapshot": "node scripts/export-platform-snapshot.mjs",
    "deploy:firebase": "bash scripts/firebase-deploy-apphosting.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:dvla-live": "node scripts/test-dvla-ves.mjs",
    "serve:ssr:driveline": "node dist/driveline/server/server.mjs",
    "screenshots:client": "node scripts/capture-client-screenshots.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "filter:images": "node scripts/filter-stock-images.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:e2e": "node scripts/e2e-site-check.mjs",
    "test:a11y": "node scripts/a11y-check.mjs",
    "verify:stock": "node scripts/verify-stock.mjs",
    "test:layout": "node scripts/layout-audit.mjs && ENGINE=webkit node scripts/layout-audit.mjs",
    "test:popups": "node scripts/interaction-audit.mjs",
    "test:pwa": "node scripts/pwa-check.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.4",
    "@angular/ssr": "^21.2.2",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.14.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.58.2",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
