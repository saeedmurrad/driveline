rules_version = '2';

// DriveLine Car Sales (project driveline-car-sales)
//
// leads/{id}   Website enquiries. Anyone may create one (the public forms), with
//              strict shape and size checks. Only staff can read them or change
//              status / notes. Nobody can delete a lead from the website or /hub.
// stats/{day}  Cookie-free visit counts, one document per London day (YYYY-MM-DD).
//              Anyone may add exactly one page view at a time; only staff can read.
// staff/{uid}  Who counts as staff. Managed in the Firebase console or by SNA Tech
//              (never writable from the website). A member may read only their own entry.
//
// The platform server (Admin SDK) bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function validNewLead(d) {
      return d.keys().hasAll(['type', 'subject', 'name', 'email', 'phone', 'message', 'page', 'status', 'notes', 'createdAt'])
        && d.keys().hasOnly(['type', 'subject', 'name', 'email', 'phone', 'message', 'page', 'status', 'notes', 'createdAt', 'vehicleId', 'vehicleLabel'])
        && d.type is string && d.type.size() > 0 && d.type.size() <= 40
        && d.subject is string && d.subject.size() <= 200
        && d.name is string && d.name.size() <= 120
        && d.email is string && d.email.size() <= 200
        && d.phone is string && d.phone.size() <= 40
        && (d.email.size() > 0 || d.phone.size() > 0)
        && d.message is string && d.message.size() <= 5000
        && d.page is string && d.page.size() <= 200
        && optionalString(d, 'vehicleId', 40)
        && optionalString(d, 'vehicleLabel', 200)
        && d.status == 'new'
        && d.notes == []
        && d.createdAt == request.time;
    }

    function validStaffUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])
        && d.status in ['new', 'contacted', 'booked', 'won', 'lost']
        && d.notes is list && d.notes.size() <= 200
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.token.email;
    }

    match /leads/{leadId} {
      allow create: if validNewLead(request.resource.data);
      allow read: if isStaff();
      allow update: if isStaff() && validStaffUpdate();
      allow delete: if false;
    }

    function mapOf(d, key) {
      return d.get(key, {});
    }

    function validStats(d) {
      return d.keys().hasOnly(['views', 'visits', 'pages', 'cars', 'sources', 'devices'])
        && d.views is int
        && d.get('visits', 0) is int
        && mapOf(d, 'pages') is map && mapOf(d, 'pages').size() <= 20
        && mapOf(d, 'cars') is map && mapOf(d, 'cars').size() <= 400
        && mapOf(d, 'sources') is map && mapOf(d, 'sources').size() <= 20
        && mapOf(d, 'devices') is map && mapOf(d, 'devices').size() <= 5;
    }

    // At most one key changed in a counter map in a single write.
    function oneKey(key) {
      return mapOf(request.resource.data, key).diff(mapOf(resource.data, key)).affectedKeys().size() <= 1;
    }

    match /stats/{day} {
      allow read: if isStaff();
      allow create: if day.matches('^20[2-9][0-9]-[01][0-9]-[0-3][0-9]$')
        && validStats(request.resource.data)
        && request.resource.data.views == 1
        && request.resource.data.get('visits', 0) <= 1
        && mapOf(request.resource.data, 'pages').size() <= 1
        && mapOf(request.resource.data, 'cars').size() <= 1
        && mapOf(request.resource.data, 'sources').size() <= 1
        && mapOf(request.resource.data, 'devices').size() <= 1;
      allow update: if validStats(request.resource.data)
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.get('visits', 0) - resource.data.get('visits', 0) in [0, 1]
        && oneKey('pages') && oneKey('cars') && oneKey('sources') && oneKey('devices');
      allow delete: if false;
    }

    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
